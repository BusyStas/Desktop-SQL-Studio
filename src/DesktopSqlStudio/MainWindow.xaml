<Window x:Class="DesktopSqlStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop SQL Studio" Height="800" Width="1200"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Query" InputGestureText="Ctrl+N" Click="NewQuery_Click" />
                <MenuItem Header="_Close Query" InputGestureText="Ctrl+W" Click="CloseQuery_Click" />
                <Separator />
                <MenuItem Header="Open _Autosave Folder" Click="OpenAutosaveFolder_Click" />
                <MenuItem Header="_Edit Config (config.json)" Click="EditConfig_Click" />
                <MenuItem Header="_Reload Config" Click="ReloadConfig_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Query">
                <MenuItem Header="_Execute" InputGestureText="F5 / Ctrl+E" Click="Execute_Click" />
                <MenuItem Header="_Cancel" Click="Cancel_Click" />
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="4,0" />
            <TextBlock x:Name="ServerLabel" FontWeight="Bold" VerticalAlignment="Center" MinWidth="120" Text="(none)" />
            <TextBlock Text="Database:" VerticalAlignment="Center" Margin="12,0,4,0" />
            <ComboBox x:Name="DatabaseCombo" Width="200" SelectionChanged="DatabaseCombo_SelectionChanged" />
            <Separator />
            <Button x:Name="ExecuteButton" Content="▶ Execute (F5)" Click="Execute_Click" />
            <Button x:Name="CancelButton" Content="■ Cancel" Click="Cancel_Click" IsEnabled="False" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TreeView x:Name="ServerTree" Grid.Column="0" SelectedItemChanged="ServerTree_SelectedItemChanged" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
            <TabControl x:Name="Tabs" Grid.Column="2" SelectionChanged="Tabs_SelectionChanged" />
        </Grid>
    </DockPanel>
</Window>
